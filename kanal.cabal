cabal-version: 3.0
name:          kanal
version:       0.1.0.0
synopsis:      Continuous geometric-thermodynamic programming language — compile to analogue wave functions
license:       MIT
author:        TYTO Labs
maintainer:    santhoshshyamsundar@tyto.studio
category:      Language
build-type:    Simple

library
  exposed-modules:
    Kanal.Core
    Kanal.Field
    Kanal.FreeEnergy
    Kanal.Admissibility
    Kanal.Kleisli
    Kanal.Realization
  build-depends:
    base >= 4.18 && < 5
  hs-source-dirs: src
  default-language: Haskell2010
